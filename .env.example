# Copier vers .env pour le développement (uvicorn + base cloud).
# Instance Docker comptable : copier .env.docker.example vers .env.docker
#   (ne pas mélanger les deux fichiers).

# Application
APP_NAME="Gestion Immobilisations Bancaires"
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# PostgreSQL (développement hors Docker — instance locale)
# Pour Docker comptable, utiliser .env.docker (voir .env.docker.example).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=immobilisations
POSTGRES_USER=immo_user
POSTGRES_PASSWORD=immo_pass
DATABASE_URL=postgresql+asyncpg://immo_user:immo_pass@localhost:5432/immobilisations
DATABASE_SSL=false

# Supabase (remplir pour cloud — ne jamais commiter .env)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=
# Mot de passe avec @ → encoder en %40 dans DATABASE_URL
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
# DATABASE_SSL=true

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Frontend
NG_APP_API_URL=http://localhost:8000/api/v1
