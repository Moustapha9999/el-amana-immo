# Copier vers .env pour le développement (uvicorn + Postgres locale du compose).
# Instance Docker : copier .env.docker.example vers .env.docker
#   (ne pas mélanger les deux fichiers).
#
# Une seule PostgreSQL 17 = BEA DIGITAL et le module immo.
# Ne jamais committer ce fichier une fois copié en .env.

# Application
APP_NAME="BEA DIGITAL"
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# PostgreSQL unique (hôte = localhost depuis la machine, postgres depuis Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=immobilisations
POSTGRES_USER=immo_user
POSTGRES_PASSWORD=immo_pass
DATABASE_URL=postgresql+asyncpg://immo_user:immo_pass@localhost:5432/immobilisations
DATABASE_SSL=false

# 1 = ne pas jouer alembic au démarrage du conteneur backend.
# Obligatoire tant que le dump Supabase n'est pas restauré.
# Alembic sur base vide = schéma faux (1re révision = ALTER de tables déjà présentes).
SKIP_MIGRATIONS=1

# Supabase (remplir uniquement pour un dump / accès cloud — ne jamais commiter .env)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=
# Mot de passe avec @ → encoder en %40 dans DATABASE_URL
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
# DATABASE_SSL=true

# Redis (compose dev uniquement)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:4200

# Frontend
NG_APP_API_URL=http://localhost:8000/api/v1
