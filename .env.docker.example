# Copier ce fichier vers .env.docker (jamais commiter .env.docker)
# Copie :  copy .env.docker.example .env.docker

APP_NAME="Gestion Immobilisations Bancaires"
APP_ENV=production
APP_DEBUG=false
API_V1_PREFIX=/api/v1

# Générer : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REMPLACER_PAR_UNE_CLE_ALEATOIRE_64_CARACTERES
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

POSTGRES_DB=immobilisations
POSTGRES_USER=immo_user
POSTGRES_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_FORT

# Surchargé par docker-compose (hôte interne "postgres")
DATABASE_URL=postgresql+asyncpg://immo_user:REMPLACER_PAR_UN_MOT_DE_PASSE_FORT@postgres:5432/immobilisations
DATABASE_SSL=false

CORS_ORIGINS=http://localhost,http://127.0.0.1
NG_APP_API_URL=/api/v1
