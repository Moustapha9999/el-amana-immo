# Copier ce fichier vers .env.docker (jamais commiter .env.docker)
# Copie :  copy .env.docker.example .env.docker
#
# Une seule PostgreSQL, une seule DATABASE_URL (surchargée par docker-compose
# vers l'hôte interne "postgres").

APP_NAME="BEA DIGITAL"
APP_ENV=production
APP_DEBUG=false
APP_VERSION=0.0.0-local
GIT_SHA=local
API_V1_PREFIX=/api/v1

# Générer : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REMPLACER_PAR_UNE_CLE_ALEATOIRE_64_CARACTERES
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
# Cookie HttpOnly du refresh token : Secure exige HTTPS (http://localhost toléré par les navigateurs).
AUTH_COOKIE_SECURE=true

POSTGRES_DB=bea_digital
POSTGRES_USER=admin
POSTGRES_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_FORT

# Compte PostgreSQL de l'application (backend + worker), sans superutilisateur.
# Créé par database/roles/bea_app.sql. admin (POSTGRES_USER) reste réservé aux
# migrations (service « migrate »), à pgAdmin et aux restaurations DSI.
# Retour arrière : BEA_APP_DB_USER=admin et BEA_APP_DB_PASSWORD=<mot de passe admin>.
BEA_APP_DB_USER=bea_app
BEA_APP_DB_PASSWORD=REMPLACER_PAR_UN_AUTRE_MOT_DE_PASSE_FORT_24_CARACTERES_MIN

# Surchargé par docker-compose (hôte interne "postgres")
DATABASE_URL=postgresql+asyncpg://admin:REMPLACER_PAR_UN_MOT_DE_PASSE_FORT@postgres:5432/bea_digital
DATABASE_SSL=false
# Pool SQLAlchemy (un processus uvicorn). Pool saturé → 503 DATABASE_BUSY.
# Défauts SQLAlchemy : 5 + 10 overflow, 30 s d'attente. À monter seulement
# si les journaux montrent `database_pool_exhausted`, pas en cas de 429.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30

# 1 = ne pas jouer alembic au démarrage.
# Obligatoire jusqu'au restore du dump Supabase.
# Alembic sur base vide = schéma faux (1re révision = ALTER de tables déjà présentes).
# Après restore réussi uniquement : SKIP_MIGRATIONS=0 pour de nouvelles révisions incrémentales.
SKIP_MIGRATIONS=1

CORS_ORIGINS=http://localhost
# Proxys autorisés à transmettre l'IP cliente : le nginx du conteneur frontend (défaut du compose).
TRUSTED_PROXIES=frontend
NG_APP_API_URL=/api/v1

# pgAdmin (http://localhost:5050) - identifiants de l'interface web, pas ceux de PostgreSQL
PGADMIN_DEFAULT_EMAIL=admin@bea-digital.mr
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin

# Achats : 1 = phase de test (verrous leves, suppression en cascade). Mettre 0 avant la production.
ACHATS_MODE_TEST=0

# Clientèle : classement de masse SCORE. 0 tant que la Conformité n'a pas validé.
# Les deux doivent être renseignés pour ouvrir (référence de PV tracée dans l'audit).
CLIENTELE_CLASSEMENT_MASSE_ACTIF=0
CLIENTELE_CLASSEMENT_MASSE_VALIDATION=
