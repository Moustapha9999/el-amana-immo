# Copier vers .env.production sur le serveur (HORS Git).
# Ne jamais committer .env.production.

APP_NAME="BEA DIGITAL"
APP_ENV=production
APP_DEBUG=false
API_DOCS_ENABLED=false
API_V1_PREFIX=/api/v1

# Injectés aussi par compose / pipeline au deploy
APP_VERSION=v0.0.0
GIT_SHA=unknown

SECRET_KEY=REMPLACER_PAR_UNE_CLE_ALEATOIRE_64_CARACTERES
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

POSTGRES_DB=bea_digital
POSTGRES_USER=bea_digital_app
POSTGRES_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_FORT

DATABASE_URL=postgresql+asyncpg://bea_digital_app:REMPLACER_PAR_UN_MOT_DE_PASSE_FORT@postgres:5432/bea_digital
DATABASE_SSL=false

# 1 jusqu'au restore / schéma réel ; 0 seulement pour migrations incrémentales contrôlées
SKIP_MIGRATIONS=1

# Origines HTTPS réelles (domaine banque) — à renseigner avec l'IT
CORS_ORIGINS=https://REMPLACER_PAR_DOMAINE_BEA

# Images (également via variables shell au compose)
BEA_VERSION=v0.0.0
BEA_IMAGE_BACKEND=registry.example/bea-digital/backend
BEA_IMAGE_FRONTEND=registry.example/bea-digital/frontend
GIT_SHA=unknown

NG_APP_API_URL=/api/v1
