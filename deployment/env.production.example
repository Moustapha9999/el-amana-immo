# BEA DIGITAL — PRODUCTION. Copier vers /opt/bea-digital/.env.production (HORS Git, droits 600).
# Les valeurs REMPLACER_* sont obligatoires. Générer les secrets sur le serveur :
#   openssl rand -hex 32        (SECRET_KEY)
#   openssl rand -base64 24     (POSTGRES_PASSWORD, sans caractères @ : / ?)

APP_NAME="BEA DIGITAL"
APP_ENV=production
APP_DEBUG=false
API_DOCS_ENABLED=false

# --- Sécurité / sessions ---------------------------------------------------------
SECRET_KEY=REMPLACER_PAR_64_CARACTERES_ALEATOIRES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=1
MFA_REQUIRED_FOR_CORE_ADMIN=true
LOGIN_LOCKOUT_MAX_FAILURES=5
RATE_LIMIT_ENABLED=true

# --- Base PostgreSQL (conteneur, réseau interne, aucun port publié) -------------
# DATABASE_URL est construite par docker-compose.prod.yml à partir de ces valeurs.
POSTGRES_DB=bea_digital
POSTGRES_USER=bea_digital_app
POSTGRES_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_FORT
DATABASE_SSL=false

# --- Exposition -----------------------------------------------------------------
# Adresse d'écoute du conteneur frontend ; le reverse proxy HTTPS de l'hôte pointe dessus.
BEA_HTTP_BIND=127.0.0.1:8080
# URL publique (domaine interne fourni par la DSI) : liens des e-mails et CORS.
PUBLIC_APP_URL=https://REMPLACER_PAR_DOMAINE_BEA
CORS_ORIGINS=https://REMPLACER_PAR_DOMAINE_BEA
# Proxys autorisés à transmettre l'IP cliente (X-Forwarded-For), jamais 0.0.0.0/0.
# Chaîne : reverse proxy HTTPS de l'hôte → conteneur frontend (nginx) → backend.
# Ajouter l'adresse sous laquelle le conteneur frontend voit le reverse proxy de l'hôte,
# relevée sur le serveur (souvent la passerelle du réseau bea_internal) :
#   docker network inspect bea_internal -f '{{(index .IPAM.Config 0).Gateway}}'
# Sans elle, l'IP enregistrée et le rate limiting retiennent cette passerelle pour tous les agents.
TRUSTED_PROXIES=frontend,REMPLACER_PAR_IP_VUE_PAR_LE_CONTENEUR_FRONTEND

# --- Images ---------------------------------------------------------------------
# Hors ligne (archive) : laisser bea-digital/backend et bea-digital/frontend.
# Registre : registre-interne/bea-digital/backend, …
BEA_IMAGE_BACKEND=bea-digital/backend
BEA_IMAGE_FRONTEND=bea-digital/frontend

# --- Messagerie (notifications, mot de passe oublié) — serveur SMTP interne ------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# --- Antivirus des pièces jointes (optionnel, ClamAV de la DSI) -----------------
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Modules --------------------------------------------------------------------
ACHATS_MODE_TEST=false
CLIENTELE_CLASSEMENT_MASSE_ACTIF=false
