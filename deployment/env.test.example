# BEA DIGITAL — TEST (recette). Copier vers /opt/bea-digital/.env.test sur le serveur de TEST (HORS Git).
# Même contenu que la production, avec des secrets DIFFÉRENTS et des données de recette
# (copie anonymisée ou dump de production validé par la conformité).
#   ENV_FILE=.env.test BEA_VERSION=v1.0.0 IMAGES_TAR=releases/v1.0.0/images.tar ./deployment/scripts/deploy.sh

APP_NAME="BEA DIGITAL (TEST)"
APP_ENV=test
APP_DEBUG=false
API_DOCS_ENABLED=true

SECRET_KEY=REMPLACER_PAR_64_CARACTERES_ALEATOIRES_DIFFERENTS_DE_LA_PROD
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=1
MFA_REQUIRED_FOR_CORE_ADMIN=false
RATE_LIMIT_ENABLED=true

POSTGRES_DB=bea_digital
POSTGRES_USER=bea_digital_app
POSTGRES_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_FORT
DATABASE_SSL=false

BEA_HTTP_BIND=127.0.0.1:8080
PUBLIC_APP_URL=https://REMPLACER_PAR_DOMAINE_TEST
CORS_ORIGINS=https://REMPLACER_PAR_DOMAINE_TEST
# Même règle qu'en production (voir env.production.example) : frontend + adresse du reverse proxy hôte.
TRUSTED_PROXIES=frontend,REMPLACER_PAR_IP_VUE_PAR_LE_CONTENEUR_FRONTEND

BEA_IMAGE_BACKEND=bea-digital/backend
BEA_IMAGE_FRONTEND=bea-digital/frontend

# En TEST, ne pas envoyer de vrais e-mails aux agents : laisser vide ou SMTP de recette.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

ACHATS_MODE_TEST=true
CLIENTELE_CLASSEMENT_MASSE_ACTIF=false
